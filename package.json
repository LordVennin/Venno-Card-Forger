{
  "name": "cardsmith",
  "private": true,
  "version": "0.0.0",
  "license": "MPL-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @cardsmith/desktop tauri dev",
    "build": "pnpm --filter @cardsmith/desktop tauri build",
    "test": "vitest run",
    "test:rust": "cargo test --workspace",
    "test:parity": "pnpm --filter @cardsmith/desktop exec tsx scripts/parity.ts",
    "typecheck": "pnpm build:wasm && tsc -b && pnpm --filter @cardsmith/desktop check",
    "survey": "tsx packages/importer/src/survey/cli.ts",
    "composite": "tsx packages/importer/src/composite/cli.ts",
    "build:wasm": "cargo build --release -p cardsmith-wasm --target wasm32-unknown-unknown && mkdir -p apps/desktop/src/wasm && cp target/wasm32-unknown-unknown/release/cardsmith_wasm.wasm apps/desktop/src/wasm/cardsmith.wasm",
    "import:psd": "tsx packages/importer/src/import/cli.ts",
    "test:golden": "tsx tests/golden/run.ts",
    "test:text": "tsx tests/text/run.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
